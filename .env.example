# ==============================================================================
# Environment Configuration Template
# ==============================================================================

# Application Settings
ENVIRONMENT=production
DEBUG=false
PORT=8000
HOST=0.0.0.0

# PostgreSQL Database Configuration
POSTGRES_USER=clouduser
POSTGRES_PASSWORD=ChangeThisToStrongPassword123!
POSTGRES_DB=cloudappdb
POSTGRES_PORT=5432

# SQLAlchemy Database Connection URL
# For Docker Compose: host is 'db'
# For Local Host: host is 'localhost'
DATABASE_URL=postgresql://clouduser:ChangeThisToStrongPassword123!@db:5432/cloudappdb
